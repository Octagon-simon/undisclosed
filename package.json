{
  "private": true,
  "name": "undisclosed",
  "version": "0.0.9",
  "description": "Undisclosed's editor-first shell, built as a custom Eclipse Theia product. The code editor is the primary surface; Undisclosed's agent + features are added as native Theia contributions (Antigravity model).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Undisclosed",
        "warnOnPotentiallyInsecureHostPattern": false,
        "preferences": {
          "security.workspace.trust.enabled": false,
          "workbench.startupEditor": "none",
          "files.enableTrash": false,
          "terminal.integrated.profiles.osx": {
            "zsh": {
              "path": "zsh"
            },
            "zsh (login)": {
              "path": "zsh",
              "args": [
                "-l"
              ]
            },
            "bash": {
              "path": "bash"
            },
            "sh": {
              "path": "sh"
            }
          },
          "terminal.integrated.defaultProfile.osx": "zsh",
          "terminal.integrated.profiles.linux": {
            "bash": {
              "path": "bash"
            },
            "zsh": {
              "path": "zsh"
            },
            "sh": {
              "path": "sh"
            }
          },
          "terminal.integrated.defaultProfile.linux": "bash",
          "workbench.colorCustomizations": {
            "peekViewResult.selectionBackground": "#37373d",
            "peekViewResult.selectionForeground": "#ffffff",
            "peekViewResult.lineForeground": "#d4d4d4",
            "peekViewResult.matchHighlightBackground": "#ea5c0099",
            "peekViewEditor.matchHighlightBackground": "#ea5c0066"
          }
        }
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "_theiaPlugins_note": "Keep in sync with apps/desktop/package.json. VS Code builtin LSPs pinned to 1.95.3 (open-vsx `vscode` namespace, Theia 1.60). Only language-features for languages undisclosed-languages already registers (ts/tsx/js/css/html); vscode.json grammar added since json/jsonc aren't registered. Prettier is pinned to 11.0.3, its last CommonJS release: 12.x ships `\"type\": \"module\"` and the Theia 1.60 plugin host (Electron 30 / Node 20) require()s extension entries, so ESM builds fail with ERR_REQUIRE_ESM. Run `npm run download:plugins` (network) before build.",
  "theiaPlugins": {
    "vscode.typescript-language-features": "https://open-vsx.org/api/vscode/typescript-language-features/1.95.3/file/vscode.typescript-language-features-1.95.3.vsix",
    "vscode.css-language-features": "https://open-vsx.org/api/vscode/css-language-features/1.95.3/file/vscode.css-language-features-1.95.3.vsix",
    "vscode.html-language-features": "https://open-vsx.org/api/vscode/html-language-features/1.95.3/file/vscode.html-language-features-1.95.3.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.json-language-features": "https://open-vsx.org/api/vscode/json-language-features/1.95.3/file/vscode.json-language-features-1.95.3.vsix",
    "vscode.emmet": "https://open-vsx.org/api/vscode/emmet/1.95.3/file/vscode.emmet-1.95.3.vsix",
    "vscode.markdown-language-features": "https://open-vsx.org/api/vscode/markdown-language-features/1.95.3/file/vscode.markdown-language-features-1.95.3.vsix",
    "vscode.markdown-math": "https://open-vsx.org/api/vscode/markdown-math/1.95.3/file/vscode.markdown-math-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix",
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "esbenp.prettier-vscode": "https://open-vsx.org/api/esbenp/prettier-vscode/11.0.3/file/esbenp.prettier-vscode-11.0.3.vsix",
    "dbaeumer.vscode-eslint": "https://open-vsx.org/api/dbaeumer/vscode-eslint/3.0.34/file/dbaeumer.vscode-eslint-3.0.34.vsix"
  },
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/debug": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/file-search": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/scm": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/navigator": "1.76.0",
    "@theia/output": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/search-in-workspace": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/vsx-registry": "1.76.0",
    "@theia/workspace": "1.76.0",
    "undisclosed-agent": "file:packages/undisclosed-agent",
    "undisclosed-git": "file:packages/undisclosed-git",
    "undisclosed-import": "file:packages/undisclosed-import",
    "undisclosed-languages": "file:packages/undisclosed-languages",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "yargs": "^17.7.3"
  },
  "scripts": {
    "clean": "theia clean",
    "download:plugins": "theia download:plugins",
    "build": "npm run build:packages && npm run download:plugins && theia build --mode development",
    "build:prod": "npm run build:packages && npm run download:plugins && theia build --mode production",
    "build:packages": "npm --prefix packages/undisclosed-agent run build && npm --prefix packages/undisclosed-git run build && npm --prefix packages/undisclosed-import run build && npm --prefix packages/undisclosed-languages run build",
    "setup": "npm install && npm run build:packages",
    "start": "THEIA_DEFAULT_PLUGINS=local-dir:plugins THEIA_WEBVIEW_EXTERNAL_ENDPOINT='{{hostname}}' theia start --hostname 0.0.0.0 --port 3000",
    "watch": "theia build --watch --mode development",
    "build:agent-ui": "npm --prefix agent-ui run build:agent-embed && npm run sync:agent-bundle",
    "sync:agent-bundle": "cp agent-ui/dist-agent-embed/agent-embed.umd.js agent-ui/dist-agent-embed/style.css packages/undisclosed-agent/assets/agent-embed/ && echo synced",
    "dist:brain": "bash scripts/build-brain.sh",
    "dist:prepare": "npm run build:agent-ui",
    "desktop:install": "npm --prefix apps/desktop install",
    "dist": "npm run dist:brain && npm run dist:prepare && npm --prefix apps/desktop run dist",
    "dist:mac": "npm run dist:brain && npm run dist:prepare && npm --prefix apps/desktop run dist:mac",
    "dist:win": "npm run dist:brain && npm run dist:prepare && npm --prefix apps/desktop run dist:win",
    "dist:linux": "npm run dist:brain && npm run dist:prepare && npm --prefix apps/desktop run dist:linux",
    "release": "bash scripts/release.sh",
    "release:beta": "bash scripts/release.sh beta",
    "verify:fresh": "bash scripts/verify-fresh.sh"
  }
}
