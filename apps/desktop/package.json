{
  "private": true,
  "name": "@undisclosed/desktop",
  "version": "0.0.1",
  "description": "Undisclosed desktop app — an Electron Theia shell that hosts the editor + agent and spawns the Python brain sidecar.",
  "license": "Apache-2.0",
  "author": "Simon Ugorji",
  "main": "lib/backend/electron-main.js",
  "engines": {
    "node": ">=18 <=20"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Undisclosed",
        "warnOnPotentiallyInsecureHostPattern": false,
        "preferences": {
          "security.workspace.trust.enabled": false,
          "workbench.startupEditor": "none",
          "files.enableTrash": false,
          "window.titleBarStyle": "native",
          "window.menuBarVisibility": "classic"
        }
      }
    },
    "backend": {
      "config": {
        "startupTimeout": -1
      }
    }
  },
  "dependencies": {
    "@theia/core": "1.60.0",
    "@theia/editor": "1.60.0",
    "@theia/electron": "1.60.0",
    "@theia/file-search": "1.60.0",
    "@theia/filesystem": "1.60.0",
    "@theia/git": "1.60.0",
    "@theia/markers": "1.60.0",
    "@theia/messages": "1.60.0",
    "@theia/monaco": "1.60.0",
    "@theia/navigator": "1.60.0",
    "@theia/plugin-ext": "1.60.0",
    "@theia/plugin-ext-vscode": "1.60.0",
    "@theia/preferences": "1.60.0",
    "@theia/process": "1.60.0",
    "@theia/scm": "1.60.0",
    "@theia/scm-extra": "1.60.0",
    "@theia/search-in-workspace": "1.60.0",
    "@theia/terminal": "1.60.0",
    "@theia/vsx-registry": "1.60.0",
    "@theia/workspace": "1.60.0",
    "undisclosed-agent": "file:../../packages/undisclosed-agent",
    "undisclosed-import": "file:../../packages/undisclosed-import",
    "undisclosed-languages": "file:../../packages/undisclosed-languages",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@theia/cli": "1.60.0",
    "electron": "30.1.2",
    "electron-builder": "^24.13.3",
    "terser-webpack-plugin": "^5.6.1"
  },
  "overrides": {
    "@vscode/ripgrep": "1.15.9"
  },
  "scripts": {
    "clean": "theia clean",
    "build": "theia build --mode production",
    "watch": "theia build --watch --mode development",
    "start": "theia start",
    "rebuild": "theia rebuild:electron",
    "dist": "npm run rebuild && npm run build && electron-builder --publish never -c electron-builder.yml",
    "dist:mac": "npm run rebuild && npm run build && electron-builder --publish never -c electron-builder.yml --mac dmg zip",
    "dist:win": "npm run rebuild && npm run build && electron-builder --publish never -c electron-builder.yml --win nsis",
    "dist:linux": "npm run rebuild && npm run build && electron-builder --publish never -c electron-builder.yml --linux AppImage deb"
  }
}
