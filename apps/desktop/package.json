{
  "private": true,
  "name": "@undisclosed/desktop",
  "version": "0.0.8",
  "description": "Undisclosed desktop app — an Electron Theia shell that hosts the editor + agent and spawns the Python brain sidecar.",
  "license": "Apache-2.0",
  "author": "Simon Ugorji",
  "repository": {
    "type": "git",
    "url": "https://github.com/Octagon-simon/undisclosed.git"
  },
  "main": "electron-entry.js",
  "engines": {
    "node": ">=18 <=20"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Undisclosed",
        "warnOnPotentiallyInsecureHostPattern": false,
        "preferences": {
          "security.workspace.trust.enabled": false,
          "workbench.startupEditor": "none",
          "files.enableTrash": false,
          "window.titleBarStyle": "native",
          "window.menuBarVisibility": "classic",
          "terminal.integrated.profiles.osx": {
            "zsh": {
              "path": "zsh"
            },
            "zsh (login)": {
              "path": "zsh",
              "args": [
                "-l"
              ]
            },
            "bash": {
              "path": "bash"
            },
            "sh": {
              "path": "sh"
            }
          },
          "terminal.integrated.defaultProfile.osx": "zsh",
          "terminal.integrated.profiles.linux": {
            "bash": {
              "path": "bash"
            },
            "zsh": {
              "path": "zsh"
            },
            "sh": {
              "path": "sh"
            }
          },
          "terminal.integrated.defaultProfile.linux": "bash",
          "workbench.colorCustomizations": {
            "peekViewResult.selectionBackground": "#37373d",
            "peekViewResult.selectionForeground": "#ffffff",
            "peekViewResult.lineForeground": "#d4d4d4",
            "peekViewResult.matchHighlightBackground": "#ea5c0099",
            "peekViewEditor.matchHighlightBackground": "#ea5c0066"
          }
        }
      }
    },
    "backend": {
      "config": {
        "startupTimeout": -1
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "_theiaPlugins_note": "VS Code builtin extensions, pinned to 1.95.3 (the version open-vsx hosts under the `vscode` namespace for Theia 1.60). Only LANGUAGE-FEATURES (LSP) are added for languages undisclosed-languages already registers (ts/tsx/js/css/html) to avoid double language registration; the `vscode.json` grammar IS added because undisclosed-languages does not register json/jsonc. Prettier is pinned to 11.0.3, its last CommonJS release: 12.x is `\"type\": \"module\"` and the Theia 1.60 plugin host (Electron 30 / Node 20) require()s extension entries, so ESM builds fail on activation with ERR_REQUIRE_ESM. Run `npm run download:plugins` (network) before build.",
  "theiaPlugins": {
    "vscode.typescript-language-features": "https://open-vsx.org/api/vscode/typescript-language-features/1.95.3/file/vscode.typescript-language-features-1.95.3.vsix",
    "vscode.css-language-features": "https://open-vsx.org/api/vscode/css-language-features/1.95.3/file/vscode.css-language-features-1.95.3.vsix",
    "vscode.html-language-features": "https://open-vsx.org/api/vscode/html-language-features/1.95.3/file/vscode.html-language-features-1.95.3.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.json-language-features": "https://open-vsx.org/api/vscode/json-language-features/1.95.3/file/vscode.json-language-features-1.95.3.vsix",
    "vscode.emmet": "https://open-vsx.org/api/vscode/emmet/1.95.3/file/vscode.emmet-1.95.3.vsix",
    "vscode.markdown-language-features": "https://open-vsx.org/api/vscode/markdown-language-features/1.95.3/file/vscode.markdown-language-features-1.95.3.vsix",
    "vscode.markdown-math": "https://open-vsx.org/api/vscode/markdown-math/1.95.3/file/vscode.markdown-math-1.95.3.vsix",
    "esbenp.prettier-vscode": "https://open-vsx.org/api/esbenp/prettier-vscode/11.0.3/file/esbenp.prettier-vscode-11.0.3.vsix",
    "dbaeumer.vscode-eslint": "https://open-vsx.org/api/dbaeumer/vscode-eslint/3.0.34/file/dbaeumer.vscode-eslint-3.0.34.vsix"
  },
  "dependencies": {
    "@theia/core": "1.60.0",
    "@theia/debug": "1.60.0",
    "@theia/editor": "1.60.0",
    "@theia/electron": "1.60.0",
    "@theia/file-search": "1.60.0",
    "@theia/filesystem": "1.60.0",
    "@theia/git": "1.60.0",
    "@theia/markers": "1.60.0",
    "@theia/messages": "1.60.0",
    "@theia/monaco": "1.60.0",
    "@theia/navigator": "1.60.0",
    "@theia/output": "1.60.0",
    "@theia/plugin-ext": "1.60.0",
    "@theia/plugin-ext-vscode": "1.60.0",
    "@theia/preferences": "1.60.0",
    "@theia/process": "1.60.0",
    "@theia/scm": "1.60.0",
    "@theia/scm-extra": "1.60.0",
    "@theia/search-in-workspace": "1.60.0",
    "@theia/terminal": "1.60.0",
    "@theia/vsx-registry": "1.60.0",
    "@theia/workspace": "1.60.0",
    "undisclosed-agent": "file:../../packages/undisclosed-agent",
    "undisclosed-git": "file:../../packages/undisclosed-git",
    "undisclosed-import": "file:../../packages/undisclosed-import",
    "undisclosed-languages": "file:../../packages/undisclosed-languages",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@theia/cli": "1.60.0",
    "electron": "30.1.2",
    "electron-builder": "^24.13.3",
    "terser-webpack-plugin": "^5.6.1"
  },
  "overrides": {
    "@vscode/ripgrep": "1.15.9"
  },
  "scripts": {
    "clean": "theia clean",
    "download:plugins": "theia download:plugins",
    "build:packages": "npm --prefix ../../packages/undisclosed-agent run build && npm --prefix ../../packages/undisclosed-git run build && npm --prefix ../../packages/undisclosed-import run build && npm --prefix ../../packages/undisclosed-languages run build",
    "build:theia": "theia build --mode production",
    "build": "npm run build:packages && npm run build:theia",
    "watch": "theia build --watch --mode development",
    "start": "theia start",
    "rebuild": "theia rebuild:electron",
    "package": "electron-builder --publish never -c electron-builder.yml",
    "package:dir": "electron-builder --dir --publish never -c electron-builder.yml",
    "dist": "npm run rebuild && npm run download:plugins && npm run build && npm run package",
    "dist:mac": "npm run rebuild && npm run download:plugins && npm run build && npm run package -- --mac dmg zip",
    "dist:win": "npm run rebuild && npm run download:plugins && npm run build && npm run package -- --win nsis",
    "dist:linux": "npm run rebuild && npm run download:plugins && npm run build && npm run package -- --linux AppImage deb"
  }
}
