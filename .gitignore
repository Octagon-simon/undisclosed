# Dependencies
node_modules/

# Theia build output
lib/
!agent-ui/src/lib/
!agent-ui/src/lib/**
src-gen/
.browser_modules/
gen-webpack*.js
.theia/
plugins/
*.log

# Editor/OS cruft
.DS_Store
.vscode/

# local dev session (contains a token) — never commit
session.local.json
**/session.local.json

# Local agent data (skills symlink → ~/.eigent/skills); not part of the repo
.agents/

# Agent todo scratch (now stored per-project under ~/.eigent/todos)
.todo.json
todo.md
.brain.log
.brain.pid
.brain-setup.log
.brain.run
.brain.log.prev

# Editor/agent scratch backups (dead duplicate code — token/context noise)
*.bak

# Local backups
.tmp/

# Local env files (secrets) — keep the committable template
.env
.env.*
!.env.sample
!.env.example
agent-ui/.env
agent-ui/.env.*
apps/desktop/node_modules/
apps/desktop/lib/
apps/desktop/src-gen/
apps/desktop/dist/
apps/desktop/.theia/
apps/desktop/gen-webpack*.js
brain/dist/
brain/build/
brain/*.spec

*.png 
*.md

# Regenerate with `npm --prefix agent-ui run icons:file-extensions`.
# The generated artifacts ARE committed, so they must not be swept up by the
# blanket `*.md` rule above.
!agent-ui/src/assets/fileIcons.LICENSE.md

# Offline cache for the Simple Icons fetch script (regenerable, not shipped).
.cache/file-icons/