# Dependencies
node_modules/

# Theia build output
lib/
!agent-ui/src/lib/
!agent-ui/src/lib/**
src-gen/
.browser_modules/
gen-webpack*.js
gen-esbuild*.mjs
.theia/
plugins/
*.log

# Editor/OS cruft
.DS_Store
.vscode/

# local dev session (contains a token) — never commit
session.local.json
**/session.local.json

# Local agent data (skills symlink → ~/.eigent/skills); not part of the repo
.agents/

# Agent todo scratch (now stored per-project under ~/.eigent/todos)
.todo.json
todo.md
.brain.log
.brain.pid
.brain-setup.log
.brain.run
.brain.log.prev

# Editor/agent scratch backups (dead duplicate code — token/context noise)
*.bak
*.orig
*.rej
*.backup
*.old
*~

# Local backups
.tmp/

# Local env files (secrets) — keep the committable template
.env
.env.*
!.env.sample
!.env.example
agent-ui/.env
agent-ui/.env.*
apps/desktop/node_modules/
apps/desktop/lib/
apps/desktop/src-gen/
apps/desktop/dist/
apps/desktop/dist-fresh/
apps/desktop/.theia/
apps/desktop/gen-webpack*.js
apps/desktop/gen-esbuild*.mjs
brain/dist/
brain/build/
brain/*.spec

*.png 
*.md

# Regenerate with `npm --prefix agent-ui run icons:file-extensions`.
# The generated artifacts ARE committed, so they must not be swept up by the
# blanket `*.md` rule above.
!agent-ui/src/assets/fileIcons.LICENSE.md

# Repo documentation under docs/ IS committed — re-include it despite the
# blanket `*.md` rule above. The `docs/` directory itself is not ignored (only
# `*.md` files are), so no parent directory needs re-including first.
!docs/
!docs/**/*.md

# Real-work fixtures: the task prompt and README are part of the fixture.
!benchmarks/
!benchmarks/**/*.md

# Offline cache for the Simple Icons fetch script (regenerable, not shipped).
.cache/file-icons/

# Marketing landing page (site/): a self-contained, deployable page. Re-include
# it despite the blanket `*.png` / `*.md` rules above so its files are not
# silently dropped from the repo. It is NOT part of the app build (see
# apps/desktop/electron-builder.yml).
!site/
!site/**

# Bundled example agent skills (resources/example-skills/): ship with the app and
# are synced into each user's skill store. Re-include the whole tree, not just
# `SKILL.md`: the blanket `*.md`, `*.png`, and `lib/` rules above would otherwise
# silently drop skills' asset files (PNG textures) and `lib/` script dirs.
!resources/example-skills/**

# Page-camera binary (github.com/brijr/iris). Fetched per platform by
# scripts/fetch-iris.sh and bundled by electron-builder; never commit it.
resources/binaries/iris/*/
# Local page shots from `npm run shot`.
.screenshots/
brag-output-2026-10-11-065557/
demo-live/
capture.mov

# local screen-recording frames (source is videos/undisclosed-demo/assets/capture.mp4)
capture-2026-10-17/

# Demo video production: compositions, storyboards, renders and per-version
# comparison pages. 230+ MB of working files; only the final cuts ship, in
# docs/media/ (README) and site/ (landing page).
videos/

# One-off local artifacts from screen capture and OCR passes.
*.tiff
.tmp-ocr.*

# Scratch dumps from debugging/build runs (screenshots are already covered by *.png)
agent-progress*.html
chat_history_preserve.txt
COMMIT_MESSAGES.md
dist/*.skill

# The `!site/**` exception above re-includes everything under site/, including
# editor auto-backups. Keep those out of the deployable tree.
site/**/*.bak
