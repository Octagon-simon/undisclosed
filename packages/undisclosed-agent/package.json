{
  "name": "undisclosed-agent",
  "version": "0.0.1",
  "private": true,
  "description": "Undisclosed agent panel as a Theia extension (ReactWidget in the right dock). Hosts the on-device agent UI. Agentic features powered by Eigent.ai.",
  "license": "Apache-2.0",
  "theiaExtensions": [
    {
      "frontend": "lib/browser/undisclosed-agent-frontend-module",
      "backend": "lib/node/undisclosed-agent-backend-module",
      "electronMain": "lib/electron-main/brain-teardown",
      "style": "style/undisclosed-agent.css"
    }
  ],
  "dependencies": {
    "@theia/core": "1.60.0",
    "@theia/editor": "1.60.0",
    "@theia/filesystem": "1.60.0",
    "@theia/git": "1.60.0",
    "@theia/scm": "1.60.0",
    "@theia/workspace": "1.60.0"
  },
  "devDependencies": {
    "typescript": "~5.4.5"
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "files": [
    "lib",
    "src",
    "assets",
    "style"
  ]
}
