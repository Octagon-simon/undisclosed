{"name": "eigent-languages", "version": "0.0.1", "private": true, "description": "Eigent editor language support: registers Monarch tokenizers for the popular languages directly against Theia's Monaco.", "license": "Apache-2.0", "theiaExtensions": [{"frontend": "lib/browser/eigent-languages-frontend-module"}], "dependencies": {"@theia/core": "1.60.0", "@theia/monaco": "1.60.0", "@theia/monaco-editor-core": "1.96.302"}, "devDependencies": {"typescript": "~5.4.5"}, "scripts": {"build": "tsc -p .", "watch": "tsc -w -p .", "generate:languages": "node script/generate.js"}, "files": ["lib", "src", "script"]}