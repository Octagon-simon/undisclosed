# =============================================================================
# Undisclosed — environment sample
# =============================================================================
# Copy to `.env` (repo root) or `brain/.env`; both are auto-loaded by the brain
# at startup and are gitignored. Everything here is OPTIONAL — the app runs with
# sane defaults. Uncomment and set only what you need. Restart the brain after
# editing:  ./scripts/brain.sh restart
#
# Precedence: values in these .env files use override=True, so they win over a
# shell `export`. Once a var is here, this file is the source of truth.
# =============================================================================


# -----------------------------------------------------------------------------
# Brain server
# -----------------------------------------------------------------------------
# UNDISCLOSED_BRAIN_PORT=5001
# UNDISCLOSED_BRAIN_HOST=127.0.0.1
# Same-origin proxy target for the agent panel's /api calls (Theia backend).
# UNDISCLOSED_PROXY_TARGET=http://localhost:3001
#
# --- Two different "restart" knobs. They do NOT do the same thing. ---
#
# UNDISCLOSED_BRAIN_RELOAD (default 0) = the FILE WATCHER. Read in brain/main.py;
# when truthy ("1"/"true"/"yes") it starts uvicorn with reload=True (WatchFiles),
# so saving any brain/**.py restarts the server process. Dev convenience only:
# it restarts on FILE EDITS, never on a crash, and is force-disabled when frozen
# (PyInstaller cannot run the reloader). Leave it OFF for the dev brain: the
# agent session runs INSIDE this process, so every reload wipes in-flight task
# state.
# UNDISCLOSED_BRAIN_RELOAD=0
#
# UNDISCLOSED_BRAIN_AUTO_RESTART (default 0) = the CRASH RESTART. Read only by
# scripts/brain.sh (never by Python); if the server exits unexpectedly the
# supervisor respawns it after 2s. It is NOT a file watcher. Only set it for an
# unattended brain; while you are working it hides crashes and wipes in-flight
# task state on every bounce.
# UNDISCLOSED_BRAIN_AUTO_RESTART=0
#
# Deployment / runtime identity. UNDISCLOSED_DEPLOYMENT_TYPE=local|cloud_vm|docker
# (blank = auto-detect; Docker is inferred from the environment).
# UNDISCLOSED_RUNTIME=electron marks the brain as hosted by the desktop app.
# UNDISCLOSED_DEPLOYMENT_TYPE=
# UNDISCLOSED_RUNTIME=
#
# Workspace root for sessions, uploads, and the files the Hands can see.
# UNDISCLOSED_WORKSPACE=~/.undisclosed/workspace
#
# Extra CORS origins (comma-separated). Blank keeps the packaged-app defaults.
# UNDISCLOSED_CORS_ORIGINS=
#
# CDP port for the "login" browser window (Cookie Management). Keep it OUT of
# the managed-task range 9223-9299 so a task browser is never mistaken for the
# login window. Default 9323.
# UNDISCLOSED_LOGIN_BROWSER_CDP_PORT=9323


# -----------------------------------------------------------------------------
# Agent behavior tuning
# -----------------------------------------------------------------------------
# Per-step timeout (seconds). A stuck step (e.g. a hung browser call) fails
# after this. Default 600 (10 min). <=0 disables the timeout.
# AGENT_STEP_TIMEOUT_SECONDS=600
#
# Sliding memory window (message count). DISABLED by default (0). A naive count
# window can slice between an assistant tool_calls message and its tool result
# (API 400) — leave off unless you know the trade-off. The loop fix is the
# stateless-per-turn reset + recall_conversation tool, not this.
# UNDISCLOSED_AGENT_MEMORY_WINDOW=0
#
# Hard cap on agent iterations per run. DISABLED by default (0): the single
# agent runs until the task is done or the step timeout fires. Set a positive N
# to re-enable a blunt safety cap.
# UNDISCLOSED_MAX_ITERATION=0
#
# Token budget the memory service targets for the assembled context. Default 8000.
# UNDISCLOSED_MEMORY_TOKEN_BUDGET=8000
#
# Turn-start acknowledgement: send an early ack so the UI shows the run started.
# AGENT_ACK_FALLBACK_MS bounds how long to wait for a real first event before
# the ack fires (default 12000 ms).
# AGENT_ACK_ENABLED=0
# AGENT_ACK_FALLBACK_MS=12000
#
# Per-field truncation caps when snapshotting a conversation for the UI/history.
# UNDISCLOSED_SNAPSHOT_MESSAGE_CAP=4000
# UNDISCLOSED_SNAPSHOT_TOOL_ARG_CAP=2000
# UNDISCLOSED_SNAPSHOT_TASK_FIELD_CAP=8000
#
# How long chat_controller waits for the browser to be ready before proceeding.
# BROWSER_PREPARE_TIMEOUT_SECONDS=8
#
# Identity attributed to local (non-authenticated) chat. Defaults: user id
# "local", email local@eigent.local, name "Local User".
# UNDISCLOSED_LOCAL_USER_ID=
# UNDISCLOSED_LOCAL_EMAIL=
# UNDISCLOSED_LOCAL_NAME=
#
# Extended thinking (Anthropic platform only) — used when "show thinking" is on
# so the live thinking stream has content. Two model APIs:
#   - Claude 5 / newer (default): adaptive thinking + an effort level.
#     UNDISCLOSED_THINKING_EFFORT=high        # low | medium | high
#   - Older Claude models: a fixed token budget. Switch APIs with:
#     UNDISCLOSED_THINKING_TYPE=enabled       # default: adaptive
#     UNDISCLOSED_THINKING_BUDGET=4096        # min 1024, only for "enabled"
#
# Tool-RAG: expose only the tools relevant to each turn (cuts token cost). On by
# default; set to 0 to send every tool schema every step.
# UNDISCLOSED_TOOL_RAG=1
# UNDISCLOSED_TOOL_ROUTER=1          # LLM router picks capabilities; 0 = embeddings only
# UNDISCLOSED_TOOL_RAG_TOPK=12
# UNDISCLOSED_TOOL_RAG_MIN_SCORE=0.10
# UNDISCLOSED_TOOL_RAG_MAX_PER_TOOLKIT=12
#
# Single agent: defer the Browser + Screenshot toolkits so a pure reasoning
# turn never launches Chromium — the agent load_capability()s them only when a
# task needs the web. On by default (requires tool-RAG). Set 0 to register them
# eagerly (old behavior).
# UNDISCLOSED_SINGLE_AGENT_LAZY_BROWSER=1
#
# Debug mode: dump the useful-for-debugging bits of each turn — prompt/messages,
# tool calls + args/results, model response (content + reasoning), token usage,
# and per-chunk streaming structure. Goes to the brain log ([DEBUG:...] lines)
# AND per-task files under ~/.undisclosed/debug/<task>.log. Off by default.
# UNDISCLOSED_DEBUG=0
# UNDISCLOSED_DEBUG_DIR=            # override the dump directory
#
# Override storage locations (default under ~/.undisclosed/).
# UNDISCLOSED_TURNS_ROOT=
# UNDISCLOSED_SKILLS_DIR=
# Extra directory of bundled/example skills to seed (marker file
# .undisclosed-example-skill). Optional.
# UNDISCLOSED_EXAMPLE_SKILLS_DIR=


# -----------------------------------------------------------------------------
# Event notifications / hooks
# -----------------------------------------------------------------------------
# Run a shell command on agent lifecycle events (permission requested, run
# finished, etc.). UNDISCLOSED_NOTIFY_COMMAND is the original single-command
# form; the event JSON payload arrives on the command's stdin.
# UNDISCLOSED_NOTIFY_COMMAND=
#
# UNDISCLOSED_HOOKS is a JSON object mapping an event name (or "*") to a command
# string or a list of commands. An explicit empty list for an event is the kill
# switch. Example:
#   UNDISCLOSED_HOOKS={"permission_requested":"node /path/hook.js","*":"logger"}
# Per-command timeout in milliseconds (default 2000).
# UNDISCLOSED_HOOK_TIMEOUT_MS=2000


# -----------------------------------------------------------------------------
# Model / LLM keys (BYOK)
# -----------------------------------------------------------------------------
# Most models are configured in the app's Models UI. These are read directly if
# a toolkit/agent needs them without a UI-configured provider.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=


# -----------------------------------------------------------------------------
# Design / dev integrations (enable the matching tools ONLY when set)
# -----------------------------------------------------------------------------
# Figma REST API — lets the agent read component/node styles directly (no
# browser canvas clicking). Figma > Settings > Account > Personal access tokens.
# FIGMA_ACCESS_TOKEN=figd_...
#
# GitHub — enables the GitHub toolkit (repos, issues, PRs).
# GITHUB_ACCESS_TOKEN=ghp_...


# -----------------------------------------------------------------------------
# Web search providers (any one enables web search; pick what you have)
# -----------------------------------------------------------------------------
# Google Programmable Search needs BOTH a key and an engine id:
# GOOGLE_API_KEY=
# SEARCH_ENGINE_ID=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=
# LINKUP_API_KEY=
# BOCHA_API_KEY=
# TONGXIAO_API_KEY=


# -----------------------------------------------------------------------------
# Productivity / comms integrations (optional; enable their toolkits when set)
# -----------------------------------------------------------------------------
# NOTION_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_USER_TOKEN=
#
# Google Workspace (Gmail / Calendar / Drive) — OAuth client + token paths:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GMAIL_CREDENTIALS_PATH=
# GOOGLE_CALENDAR_TOKEN_PATH=
# GDRIVE_CREDENTIALS_PATH=
#
# Social:
# TWITTER_CONSUMER_KEY=
# TWITTER_CONSUMER_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=
# WHATSAPP_ACCESS_TOKEN=
#
# Lark / Feishu:
# LARK_APP_ID=
# LARK_APP_SECRET=


# -----------------------------------------------------------------------------
# Browser (CDP)
# -----------------------------------------------------------------------------
# Point the agent at an already-running Chrome DevTools endpoint instead of
# letting the brain launch one. Leave blank for auto-launch on port 9222.
# UNDISCLOSED_CDP_URL=
# UNDISCLOSED_CHROME_PATH=
# UNDISCLOSED_BRAIN_LAUNCH_BROWSER=true
# BROWSER_COMMAND_TIMEOUT_SECONDS=
# Interim isolation of the shared browser tab. Leave on (default true) unless a
# task needs to share one tab across steps.
# UNDISCLOSED_INTERIM_SHARED_BROWSER_TAB_ISOLATION=true


# -----------------------------------------------------------------------------
# Hands (browser / terminal / filesystem / MCP execution surface)
# -----------------------------------------------------------------------------
# Which capabilities the agent may use, and how. Blank/auto derives them from
# UNDISCLOSED_DEPLOYMENT_TYPE (and Docker auto-detect).
# UNDISCLOSED_HANDS_MODE=                 # auto | local | sandbox | remote
# UNDISCLOSED_HANDS_TERMINAL=true
# UNDISCLOSED_HANDS_BROWSER=false
# UNDISCLOSED_HANDS_FILESYSTEM=full       # full | workspace
# UNDISCLOSED_HANDS_MCP=all
# Remote hands (cluster) — requires a kubeconfig-style cluster config file:
# UNDISCLOSED_HANDS_REMOTE=false
# UNDISCLOSED_HANDS_CLUSTER_CONFIG_FILE=


# -----------------------------------------------------------------------------
# Remote sub-agent (offload a run to a remote runtime)
# -----------------------------------------------------------------------------
# Off by default. When enabled, restrict which model providers may run remotely
# and cap the snapshot size / wall time.
# UNDISCLOSED_REMOTE_SUB_AGENT_ENABLED=false
# UNDISCLOSED_REMOTE_SUB_AGENT_ALLOWED_PROVIDERS=
# UNDISCLOSED_REMOTE_SUB_AGENT_ALLOW_SNAPSHOT_DOWNLOAD=false
# UNDISCLOSED_REMOTE_SUB_AGENT_MAX_SNAPSHOT_MB=
# UNDISCLOSED_REMOTE_SUB_AGENT_MAX_WALL_TIME_SECONDS=


# -----------------------------------------------------------------------------
# Rolling summary (the proven default memory path; used when hybrid is off)
# -----------------------------------------------------------------------------
# Summarizes older turns to stay under a char budget, keeping the last N turns
# verbatim. Backfill summarizes an existing backlog on startup.
# UNDISCLOSED_ROLLING_SUMMARY=true
# UNDISCLOSED_ROLLING_SUMMARY_CHAR_BUDGET=6000
# UNDISCLOSED_ROLLING_SUMMARY_KEEP_TURNS=8
# UNDISCLOSED_ROLLING_SUMMARY_BACKFILL=true


# -----------------------------------------------------------------------------
# Hybrid conversational memory (brain/app/memory/hybrid, see hybrid_memory.md)
# -----------------------------------------------------------------------------
# Master switch. Off by default: the proven rolling-summary path keeps serving
# until the hybrid retrieval is evaluated. Turn on to route durable context
# through the routed/episodic/structured memory stack.
# UNDISCLOSED_HYBRID_MEMORY=false
# Recent verbatim window (tokens) and its soft/hard eviction thresholds.
# UNDISCLOSED_HYBRID_RECENT_TOKENS=6000
# UNDISCLOSED_HYBRID_SOFT_THRESHOLD=0.8
# UNDISCLOSED_HYBRID_HARD_THRESHOLD=1.0
# Episode shaping.
# UNDISCLOSED_HYBRID_EPISODE_MAX_TURNS=40
# UNDISCLOSED_HYBRID_EPISODE_SUMMARY_CHARS=1200
# Retrieval depths.
# UNDISCLOSED_HYBRID_SEMANTIC_K=6
# UNDISCLOSED_HYBRID_LEXICAL_K=8
# UNDISCLOSED_HYBRID_EXACT_K=4
# UNDISCLOSED_HYBRID_RERANK_K=8
# Hybrid ranking weights (§21).
# UNDISCLOSED_HYBRID_W_SEMANTIC=0.35
# UNDISCLOSED_HYBRID_W_LEXICAL=0.30
# UNDISCLOSED_HYBRID_W_TOPIC=0.10
# UNDISCLOSED_HYBRID_W_ENTITY=0.10
# UNDISCLOSED_HYBRID_W_IMPORTANCE=0.05
# UNDISCLOSED_HYBRID_W_RECENCY=0.10
# UNDISCLOSED_HYBRID_W_PROJECT=0.15
# UNDISCLOSED_HYBRID_W_TYPE=0.05
#
# Per-source budget split (share of the context each memory type may claim):
# UNDISCLOSED_HYBRID_B_INSTRUCTIONS=0.06
# UNDISCLOSED_HYBRID_B_ACTIVE_MEMORY=0.10
# UNDISCLOSED_HYBRID_B_WORKING_MEMORY=0.08
# UNDISCLOSED_HYBRID_B_HISTORICAL=0.26
# UNDISCLOSED_HYBRID_B_EXACT=0.10
# UNDISCLOSED_HYBRID_B_RECENT=0.40
#
# §14 semantic project matching: embed each project description and blend a
# cosine signal into project resolution when lexical matching misses. Follows
# the master hybrid switch by default. FLOOR is the cosine floor (0-0.95); the
# WEIGHT blends the semantic score against the lexical one (0-1).
# UNDISCLOSED_HYBRID_PROJECT_SEMANTIC=true
# UNDISCLOSED_HYBRID_PROJECT_SEMANTIC_MIN_CHARS=12   # skip very short descriptions
# UNDISCLOSED_HYBRID_PROJECT_SEMANTIC_MAX=50         # cap projects embedded per query
# UNDISCLOSED_HYBRID_PROJECT_SEMANTIC_FLOOR=0.35
# UNDISCLOSED_HYBRID_W_PROJECT_SEMANTIC=0.6
#
# Run-end pipeline (episodes + memory extraction + working memory).
# UNDISCLOSED_HYBRID_EXTRACTION=true
# UNDISCLOSED_HYBRID_BACKGROUND=true
# Durable background jobs: persist run-end jobs so a restart can resume them,
# and recover pending jobs on startup (defaults to the master hybrid switch).
# UNDISCLOSED_HYBRID_DURABLE_JOBS=true
# UNDISCLOSED_HYBRID_JOB_RECOVERY=true
# Optional LLM extraction pass (episode draft + memory ops). The deterministic
# planner stays the fallback/validator and every model op still goes through
# HybridStore.apply_ops. Modes: off (default) | shadow (run + log a comparison,
# never writes) | write (model authors prose/ops). A bare "true"/"1" means shadow.
# UNDISCLOSED_HYBRID_LLM_EXTRACTION=off
# UNDISCLOSED_HYBRID_LLM_MAX_EVENTS=40
# UNDISCLOSED_HYBRID_LLM_MSG_CHARS=1500
# UNDISCLOSED_HYBRID_LLM_MAX_OPS=12
# UNDISCLOSED_HYBRID_LLM_MIN_EVENTS=4
# UNDISCLOSED_HYBRID_LLM_TURN_OPS=true


# -----------------------------------------------------------------------------
# Dev / test only
# -----------------------------------------------------------------------------
# Gate for the live Chroma vector-store tests (requires a real embedding model).
# Off by default; only pytest reads it.
# UNDISCLOSED_LIVE_CHROMA=1


# =============================================================================
# Frontend (agent-ui) — build-time only. These live in `agent-ui/.env`, NOT
# here: Vite reads env from the agent-ui directory at build time, and only vars
# prefixed VITE_ are exposed to the browser bundle.
# =============================================================================
# VITE_BRAIN_ENDPOINT=http://localhost:5001
# VITE_BASE_URL=
# VITE_PROXY_URL=
# VITE_APP_VERSION=
